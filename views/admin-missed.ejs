<%- include('partials/header') %>
<div class="container container-wide">
  <div class="page-head">
    <div>
      <div class="eyebrow-date">ADMIN OVERVIEW</div>
      <h1><%= heading %><% if (filteredEmployee) { %> &mdash; <%= filteredEmployee.name %><% } %></h1>
      <p><%= subheading %></p>
    </div>
    <% if (filteredEmployee) { %>
      <a class="count-pill" href="/admin/missed">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        Clear filter
      </a>
    <% } %>
  </div>

  <div class="missed-summary">
    <span class="missed-summary-count"><%= rows.length %> missed task<%= rows.length === 1 ? '' : 's' %></span>
    <span class="missed-summary-sub">Grouped by employee, most recent first.</span>
  </div>

  <% groups.forEach(function(g) { %>
    <div class="missed-group">
      <button type="button" class="missed-group-head">
        <svg class="missed-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div class="avatar"><%= g.employee.name.trim().charAt(0).toUpperCase() %></div>
        <span class="missed-group-name"><%= g.employee.name %></span>
        <span class="badge missed-count-pill"><%= g.tasks.length %> missed</span>
      </button>
      <div class="missed-group-body">
        <% g.tasks.forEach(function(r) { %>
          <div class="missed-task-row">
            <span class="missed-task-title"><%= r.task.title %></span>
            <span class="badge icon-pill pending">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.4"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= r.dateLabel %>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <% if (groups.length === 0) { %>
    <div class="list-card">
      <div class="table-scroll">
        <table>
          <tbody>
            <tr class="empty-row"><td>No missed tasks &mdash; nice and clean!</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
<script>
  (function () {
    document.querySelectorAll('.missed-group-head').forEach(function (btn) {
      btn.addEventListener('click', function () {
        btn.closest('.missed-group').classList.toggle('collapsed');
      });
    });
  })();
</script>
<%- include('partials/footer') %>
