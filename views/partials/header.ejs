<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Raja Rani PMS</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<% if (typeof role !== 'undefined' && role) { %>
<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <span class="logo-badge">RR</span>
      <span class="brand-text">
        <div class="brand-name">Raja Rani</div>
        <div class="brand-sub">Product PMS</div>
      </span>
    </div>
    <div class="nav-section-label">MAIN MENU</div>
    <nav>
      <% if (role === 'admin') { %>
        <a class="nav-link <%= path && path.startsWith('/admin/dashboard') ? 'active' : '' %>" href="/admin/dashboard">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="12" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="3" y="16" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/></svg>
          Dashboard
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="nav-link <%= path && path.startsWith('/admin/employees') ? 'active' : '' %>" href="/admin/employees">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="8" r="3.2" stroke="currentColor" stroke-width="2"/><path d="M3.5 20c0-3.5 2.7-6 5.5-6s5.5 2.5 5.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="17.5" cy="8.5" r="2.6" stroke="currentColor" stroke-width="2"/><path d="M15.8 14.2c2.4.3 4.7 2.5 4.7 5.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Employees
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="nav-link <%= path && path.startsWith('/admin/tasks') ? 'active' : '' %>" href="/admin/tasks">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 6h11M9 12h11M9 18h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 6l.8.8L6.2 5.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12l.8.8 1.4-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 18l.8.8 1.4-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Tasks
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="nav-link <%= path && path.startsWith('/admin/missed') ? 'active' : '' %>" href="/admin/missed">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Missed Tasks
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      <% } else if (role === 'viewer') { %>
        <a class="nav-link <%= path && path.startsWith('/viewer/dashboard') ? 'active' : '' %>" href="/viewer/dashboard">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="12" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="3" y="16" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/></svg>
          Dashboard
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      <% } else { %>
        <a class="nav-link <%= path && path.startsWith('/employee/dashboard') ? 'active' : '' %>" href="/employee/dashboard">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="14" y="12" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="3" y="16" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="2"/></svg>
          Dashboard
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="nav-link <%= path && path.startsWith('/employee/tasks') ? 'active' : '' %>" href="/employee/tasks">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 6h11M9 12h11M9 18h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 6l.8.8L6.2 5.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12l.8.8 1.4-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 18l.8.8 1.4-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Tasks
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      <% } %>
    </nav>
    <div class="sidebar-spacer"></div>
    <form method="POST" action="/logout">
      <button class="logout-btn" type="submit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M9 4H6a2 2 0 00-2 2v12a2 2 0 002 2h3M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Logout
      </button>
    </form>
  </aside>
  <div class="content-area">
    <header class="topbar">
      <div class="breadcrumb">
        <span class="crumb-root">PMS</span>
        <span class="crumb-sep">&rsaquo;</span>
        <span class="crumb-current"><%= typeof crumb !== 'undefined' ? crumb : 'Dashboard' %></span>
      </div>
      <div class="topbar-right">
        <div class="who">
          <div class="u-name"><%= name %></div>
          <div class="u-role"><%= roleLabel %></div>
        </div>
        <div class="avatar-wrap">
          <div class="avatar"><%= (name || '?').trim().split(/\s+/).map(function(p){ return p.charAt(0).toUpperCase(); }).slice(0,2).join('') %></div>
          <% if (typeof missedCount !== 'undefined' && missedCount > 0) { %><span class="missed-badge" title="<%= missedCount %> missed task(s), all-time"><%= missedCount %></span><% } %>
        </div>
      </div>
    </header>
    <main class="main-content">
<% } %>
