<%
  var __groupIcons = {
    daily: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
    weekly: '<rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
    biweekly: '<rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
    monthly: '<rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
    none: '<path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>'
  };
%>
<% if (!(groups || []).length) { %>
  <div class="empty-state">
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <div class="empty-state-title">Koi task nahi mila</div>
  </div>
<% } else { %>
  <% groups.forEach(function (g) { %>
    <div class="task-group">
      <div class="task-group-head">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><%- __groupIcons[g.key] || __groupIcons.none %></svg>
        <span class="task-group-title"><%= g.label %></span><span class="task-group-count"><%= g.tasks.length %></span>
      </div>
      <%- include('task-table', { tasks: g.tasks, showAssignee: false, pageUrl: pageUrl }) %>
    </div>
  <% }) %>
<% } %>
