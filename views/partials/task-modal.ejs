<div class="modal-backdrop" id="task-modal">
  <div class="modal-box">
    <div class="modal-head">
      <h3>Create Task</h3>
      <button type="button" class="modal-close" id="taskModalClose">&times;</button>
    </div>
    <div class="modal-body">
      <form method="POST" action="/admin/tasks">
        <input type="hidden" name="back" value="<%= typeof pageUrl !== 'undefined' ? pageUrl : '/admin/tasks' %>">
        <div class="field">
          <label>Task Name</label>
          <input type="text" name="title" placeholder="e.g. Update homepage banner" required>
        </div>
        <div class="field">
          <label>Description &amp; Expected Output</label>
          <textarea name="description" rows="4" placeholder="Kya karna hai, expected output kya hai..."></textarea>
        </div>
        <div class="field">
          <label>Created By</label>
          <input type="text" value="<%= typeof name !== 'undefined' ? name : 'Admin' %>" readonly style="font-weight:600;color:var(--text);cursor:default;">
        </div>
        <div class="form-grid-2">
          <div class="field">
            <label>Assign To</label>
            <select name="assignedTo" required>
              <% (typeof assignees !== 'undefined' ? assignees : (typeof employees !== 'undefined' ? employees : [])).forEach(function(e) { %>
                <option value="<%= e.id %>"><%= e.name %> — <%= e.role === 'admin' ? 'Admin' : (e.department || 'Team Member') %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label>Priority</label>
            <select name="priority">
              <option value="high">High</option>
              <option value="medium" selected>Medium</option>
              <option value="low">Low</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label>Repeats</label>
          <select name="recurrence" id="tmRecurrenceSelect">
            <option value="none">One-time (no repeat)</option>
            <option value="daily">Daily — no review needed, employee marks complete directly</option>
            <option value="weekly">Weekly</option>
            <option value="biweekly">Every 15 days</option>
            <option value="monthly">Monthly</option>
          </select>
        </div>
        <div class="form-grid-2">
          <div class="field" id="tmStartDateField">
            <label>Start Date</label>
            <input type="date" name="startDate" id="tmStartDate">
          </div>
          <div class="field" id="tmDueDateField">
            <label>Due Date</label>
            <input type="date" name="dueDate" id="tmDueDateInput" required>
          </div>
        </div>
        <div id="tmDailyNote" style="display:none;font-size:12px;color:var(--text-faint);margin-top:-8px;">Daily tasks repeat every day — koi due date select karne ki zaroorat nahi hai.</div>
        <div id="tmAutoDueNote" style="display:none;font-size:12px;color:var(--text-faint);margin-top:-8px;">Due date apne aap set ho jayegi — Start Date se 15 din baad.</div>
        <div class="field" id="tmWeeklyDaysField" style="display:none;">
          <label>Repeat Days</label>
          <div class="form-grid-2">
            <div class="field">
              <label style="font-weight:400;text-transform:none;">From Day</label>
              <select name="weeklyFromDay" id="tmWeeklyFromDay">
                <option value="0">Sunday</option>
                <option value="1" selected>Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
              </select>
            </div>
            <div class="field">
              <label style="font-weight:400;text-transform:none;">To Day</label>
              <select name="weeklyToDay" id="tmWeeklyToDay">
                <option value="0">Sunday</option>
                <option value="1" selected>Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
              </select>
            </div>
          </div>
          <div style="font-size:12px;color:var(--text-faint);">Pick the same day twice for a single weekday, or a range (e.g. Monday to Wednesday) to show the task every day in that window. It repeats on the same days every week.</div>
        </div>
        <div class="field" id="tmMonthlyDayField" style="display:none;">
          <label>Day of Month</label>
          <select name="monthlyDay" id="tmMonthlyDaySelect">
            <% for (var d = 1; d <= 31; d++) { %><option value="<%= d %>"><%= d %></option><% } %>
          </select>
          <div style="font-size:12px;color:var(--text-faint);">Task will repeat every month on this date (e.g. 12th of every month). Short months use the last day instead.</div>
        </div>
        <div class="field">
          <label>Checklist <span style="font-weight:400;color:var(--text-faint);text-transform:none;">(optional — items the employee should complete)</span></label>
          <div id="tmChecklistList"></div>
          <div class="add-check-row">
            <input type="text" id="tmChecklistInput" placeholder="e.g. Reference deck check karo">
            <button type="button" class="btn small outline" id="tmAddCheckBtn">Add</button>
          </div>
        </div>
        <div class="emp-form-actions" style="margin-top:6px;">
          <button type="button" class="btn outline" id="taskModalCancel">Cancel</button>
          <button class="btn" type="submit">Save Task</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById('task-modal');
    var openBtn = document.getElementById('openCreateTaskBtn');
    var closeBtn = document.getElementById('taskModalClose');
    var cancelBtn = document.getElementById('taskModalCancel');
    if (modal && openBtn) {
      openBtn.addEventListener('click', function () { modal.classList.add('open'); });
      closeBtn.addEventListener('click', function () { modal.classList.remove('open'); });
      cancelBtn.addEventListener('click', function () { modal.classList.remove('open'); });
      modal.addEventListener('click', function (e) { if (e.target === modal) modal.classList.remove('open'); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') modal.classList.remove('open'); });
    }

    var recurSelect = document.getElementById('tmRecurrenceSelect');
    var startField = document.getElementById('tmStartDateField');
    var dueField = document.getElementById('tmDueDateField');
    var dueInput = document.getElementById('tmDueDateInput');
    var dailyNote = document.getElementById('tmDailyNote');
    var autoDueNote = document.getElementById('tmAutoDueNote');
    var weeklyDaysField = document.getElementById('tmWeeklyDaysField');
    var monthlyDayField = document.getElementById('tmMonthlyDayField');
    function syncDueDateForRecurrence() {
      var v = recurSelect.value;
      var isDaily = v === 'daily';
      var isWeekly = v === 'weekly';
      var isMonthly = v === 'monthly';
      var isBiweekly = v === 'biweekly';
      var hidesDue = isDaily || isWeekly || isMonthly || isBiweekly;
      dueField.style.display = hidesDue ? 'none' : '';
      startField.style.display = (isWeekly || isMonthly) ? 'none' : '';
      dailyNote.style.display = isDaily ? 'block' : 'none';
      weeklyDaysField.style.display = isWeekly ? 'block' : 'none';
      monthlyDayField.style.display = isMonthly ? 'block' : 'none';
      autoDueNote.style.display = isBiweekly ? 'block' : 'none';
      dueInput.required = !hidesDue;
      if (hidesDue) dueInput.value = '';
    }
    if (recurSelect) {
      recurSelect.addEventListener('change', syncDueDateForRecurrence);
      syncDueDateForRecurrence();
    }

    var weeklyFromDay = document.getElementById('tmWeeklyFromDay');
    var weeklyToDay = document.getElementById('tmWeeklyToDay');
    if (weeklyFromDay && weeklyToDay) {
      weeklyFromDay.addEventListener('change', function () {
        if (Number(weeklyToDay.value) < Number(weeklyFromDay.value)) weeklyToDay.value = weeklyFromDay.value;
      });
    }

    var list = document.getElementById('tmChecklistList');
    var input = document.getElementById('tmChecklistInput');
    var addBtn = document.getElementById('tmAddCheckBtn');
    function addItem() {
      var val = input.value.trim();
      if (!val) return;
      var row = document.createElement('div');
      row.className = 'checklist-item';
      row.style.padding = '6px 0';
      var box = document.createElement('div');
      box.className = 'check-box';
      box.style.opacity = '0.5';
      var text = document.createElement('div');
      text.className = 'check-text';
      text.textContent = val;
      var hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'checklist';
      hidden.value = val;
      var remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'check-remove';
      remove.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
      remove.addEventListener('click', function () { row.remove(); });
      row.appendChild(box); row.appendChild(text); row.appendChild(hidden); row.appendChild(remove);
      list.appendChild(row);
      input.value = '';
      input.focus();
    }
    if (addBtn) {
      addBtn.addEventListener('click', addItem);
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addItem(); } });
    }
  })();
</script>
