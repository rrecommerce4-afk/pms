<%- include('../partials/header') %>
<%
  var d = draft, editing = !!item;
  var claimed = editing && !!(item.shootOwner || item.editor);
  var st = sm.settings;
%>
<div class="container sm">
  <%- include('_bar') %>
  <div class="page-head">
    <div>
      <div class="eyebrow-date">SOCIAL MEDIA STUDIO</div>
      <h1><%= editing ? 'Edit reel' : 'Create reel' %></h1>
      <p><%= editing ? item.title : 'Decide what to make. Nobody is assigned here — the page team claims the shoot, the eligible editors claim editing, and whoever confirms the upload becomes the publishing owner.' %></p>
    </div>
  </div>
  <% if (error) { %><div class="sm-flash error" role="alert"><%= error %></div><% } %>
  <div class="list-card">
    <form class="sm-form" method="POST" action="<%= editing ? '/social-media/reels/' + item.id + '/update' : '/social-media/reels' %>">
      <input type="hidden" name="_csrf" value="<%= sm.csrf %>">
      <input type="hidden" name="returnTo" value="<%= back %>">
      <% if (editing) { %><input type="hidden" name="rev" value="<%= item.rev %>"><% } %>
      <div class="form-grid-2">
        <div class="field span-2"><label for="f-title">Reel title *</label><input id="f-title" name="title" required maxlength="150" value="<%= d.title %>" placeholder="e.g. Diwali stencil rangoli in 60 seconds"></div>
        <div class="field"><label for="f-page">Instagram page *</label>
          <select id="f-page" name="pageId" <%= claimed ? 'disabled' : '' %>><% C.PAGES.forEach(function (p) { %><option value="<%= p.id %>" <%= d.pageId === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.handle %>)</option><% }) %></select>
          <% if (claimed) { %><input type="hidden" name="pageId" value="<%= item.pageId %>"><div class="helper-text">Locked because work has been claimed.</div><% } %>
        </div>
        <div class="field"><label for="f-priority">Priority</label><select id="f-priority" name="priority"><% C.PRIORITIES.forEach(function (p) { %><option <%= d.priority === p ? 'selected' : '' %>><%= p %></option><% }) %></select></div>
        <div class="field span-2"><label for="f-idea">Content idea / description</label><textarea id="f-idea" name="idea" rows="3" maxlength="3000" placeholder="Hook, key shots, message, CTA…"><%= d.idea %></textarea></div>
        <div class="field span-2"><label for="f-prep">Preparation notes for the shoot</label><textarea id="f-prep" name="prepNotes" rows="2" maxlength="2000" placeholder="Props, products, location, outfit, references…"><%= d.prepNotes %></textarea></div>
        <div class="field span-2"><label for="f-shoot">Planned shoot date / shoot deadline *</label><input id="f-shoot" type="datetime-local" name="shootAt" required value="<%= V.toInput(d.shootAt) %>"></div>
        <% var pg = C.getPage(d.pageId) || C.PAGES[0]; var dl = d.publishAt ? W.deadlineForPublish(d.publishAt) : null; var hasSchedule = Sched.hasAnySlot(st.publishingSchedule, pg.id); %>
        <div class="field span-2 sm-publish-block" data-sm-publish data-tz="<%= sm.tz %>" data-edit-done="<%= editing && W.isEditingDone(item) ? '1' : '' %>" data-schedule="<%= JSON.stringify(st.publishingSchedule) %>">
          <label class="sm-check"><input type="checkbox" name="hasPublishAt" value="1" data-toggle-field="pub-wrap" <%= d.publishAt ? 'checked' : '' %>> Scheduled publishing date &amp; time is known</label>
          <div id="pub-wrap">
            <input type="datetime-local" name="publishAt" value="<%= V.toInput(d.publishAt) %>" aria-label="Scheduled publishing date and time" data-publish-input>
            <div class="sm-slot-panel" data-slot-panel>
              <% if (!editing && d.publishAt) { %>Suggested from the <%= pg.shortName %> weekly schedule (first slot that leaves 24 h for editing after the shoot): <b><%= V.fmtDate(d.publishAt, 'weekday') %>, <%= V.fmtTime(d.publishAt) %></b>. You can choose another date and time.<% } else if (!hasSchedule) { %>No publishing schedule is configured for <%= pg.shortName %> yet — choose a time, or configure it in <a class="view-all" href="/social-media/settings#schedule">Settings → Publishing Schedule</a>.<% } %>
            </div>
          </div>
          <div class="sm-deadline-preview" data-deadline-preview>
            <% if (dl) { %>Editing deadline: <b><%= V.fmtDateTime(dl) %></b> (24 hours before publishing)<% if (new Date(dl) <= sm.now && !(editing && W.isEditingDone(item))) { %> — <b class="red-txt">already passed: editing would be overdue immediately</b><% } %><% } else { %>No publishing time → no editing deadline yet. Editing must be completed 24 hours before the publishing time once it is set.<% } %>
          </div>
          <% if (editing && item.editing.completion) { %><div class="helper-text">Editing was already completed on <%= V.fmtDateTime(item.editing.completion.at) %> (<%= item.editing.completion.onTime === false ? 'late' : item.editing.completion.onTime ? 'on time' : 'no deadline' %>). Changing the publishing time keeps that original result; the history shows whether it meets the new deadline.</div><% } %>
        </div>
        <div class="field span-2"><label for="f-caption">Caption (optional)</label><textarea id="f-caption" name="caption" rows="2" maxlength="2200" placeholder="Caption draft"><%= d.caption %></textarea></div>
        <% if (editing) { %>
          <div class="field span-2"><label for="f-reason">Reason for any date change<%= claimed || item.publishAt ? ' (required when the publishing time changes' + (claimed ? ' or any date changes — work has been claimed' : '') + ')' : '' %></label><input id="f-reason" name="reason" maxlength="500" value="<%= d.reason || '' %>" placeholder="e.g. Product stock delayed — management approved new date"><div class="helper-text">The previous publishing time and editing deadline are kept in the history. On-time status uses the deadline in effect when a task is completed.</div></div>
        <% } %>
      </div>
      <% if (!editing) { %><p class="sm-note">No owners are assigned here. The reel appears under “Available tasks” for the page team. Editing can only be claimed by Bansi, Bhavin, Vishnu or Krutik.</p><% } %>
      <div class="sm-form-actions"><a class="btn outline" href="<%= back %>">Cancel</a><button class="btn" type="submit"><%= editing ? 'Save changes' : 'Create reel' %></button></div>
    </form>
  </div>
</div>
<%- include('_modals') %>
<%- include('../partials/footer') %>
