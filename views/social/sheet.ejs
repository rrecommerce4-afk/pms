<%- include('../partials/header') %>
<%
  var can = sheet.can;
  // "1 Oct Thu": day and month first, weekday after.
  var fmt = function (d) { if (!d) return ''; var p = d.split('-'); return V.fmtDate(d, 'short') + ' ' + new Date(+p[0], p[1] - 1, +p[2]).toLocaleDateString('en-GB', { weekday: 'short' }); };
  var tone = { Yes: 'green', No: 'red', Done: 'green', Published: 'green', 'In Progress': 'blue', Scheduled: 'sky', Pending: 'amber' };
  // Every cell belongs to the one Save form at the top; its name says which row it is (see POST /content-sheet/save).
  function select(key, name, value) {
    var html = '<select class="sm-cell" name="' + key + '.' + name + '" form="sheet-save" aria-label="' + name + '"><option value="">—</option>';
    OPTS[name].forEach(function (o) { html += '<option' + (o === value ? ' selected' : '') + '>' + V.esc(o) + '</option>'; });
    return html + '</select>';
  }
  function postLink(r) {
    if (!r.link) return '';
    return '<a href="' + V.esc(r.link) + '" target="_blank" rel="noopener noreferrer">Open post</a>' + (r.lockedAt ? ' <span class="sm-lock" title="Locked when it was marked Published">🔒 Locked</span>' : '');
  }
  // Initials of whoever last wrote a cell: first letter of the first and last word of their name.
  function initials(name) {
    var w = String(name).split(/\s+/).filter(function (x) { return /[A-Za-z0-9]/.test(x.charAt(0)); });
    if (!w.length) return '?';
    return (w[0].charAt(0) + (w.length > 1 ? w[w.length - 1].charAt(0) : '')).toUpperCase();
  }
  function by(r, k) {
    var e = r && r.edits && r.edits[k];
    if (!e) return '';
    var n = nameOf(e.by);
    return '<span class="sm-by" title="' + V.esc(n + ' · ' + V.fmtDateTime(e.at)) + '">' + V.esc(initials(n)) + '</span>';
  }
  var cols = ['Publish Date', 'Name', 'Shoot Date', 'Material Ready For Shoot', 'Shoot Status', 'Editing Status', 'Publish Status', 'Post Link', 'Add Note'];
  var pageName = pages.filter(function (p) { return p.id === pageId; })[0].shortName;
  var url = function (pg, mo) { return '/content-sheet?page=' + pg + '&month=' + mo; };
%>
<div class="container container-wide sm">
  <div class="page-head">
    <div>
      <div class="eyebrow-date">SOCIAL MEDIA</div>
      <h1>Content Sheet</h1>
      <p>One sheet per Instagram page with every day of the month. Small initials in a cell show who wrote it (hover for the name and time). When a post is Published, add its link; the link then locks. <%= can ? 'Fill in as many rows as you like, then click Save at the top once.' : 'Your access is view-only.' %></p>
    </div>
    <span class="sm-seg"><a class="active" href="<%= url(pageId, month) %>">Sheet</a><a href="/content-sheet?view=calendar&month=<%= month %>">Calendar</a><a href="/content-sheet?view=board<%= month !== today.slice(0, 7) ? '&month=' + month : '' %>">TV Board</a></span>
  </div>
  <% if (sheet.flash) { %><div class="sm-flash <%= sheet.flash.type %>" role="status"><%= sheet.flash.text %></div><% } %>

  <% if (can) { %>
    <form class="sm-sheet-savebar" id="sheet-save" method="POST" action="/content-sheet/save">
      <input type="hidden" name="_csrf" value="<%= sheet.csrf %>">
      <input type="hidden" name="pageId" value="<%= pageId %>">
      <input type="hidden" name="month" value="<%= month %>">
      <span class="sm-sheet-unsaved" data-sheet-unsaved role="status"></span>
      <button class="btn" type="submit">Save</button>
    </form>
  <% } %>

  <div class="list-card sm-section">
    <div class="sm-pad" style="padding-top:16px;padding-bottom:12px">
      <div class="tabs sm-tabs">
        <% pages.forEach(function (p) { %><a class="tab-btn <%= p.id === pageId ? 'active' : '' %>" href="<%= url(p.id, month) %>"><%= p.shortName %></a><% }) %>
      </div>
      <div class="sm-sheet-month">
        <a class="btn small outline" href="<%= url(pageId, prevMonth) %>" aria-label="Previous month">‹ Prev</a>
        <b><%= V.fmtDate(month + '-01', 'month') %></b>
        <a class="btn small outline" href="<%= url(pageId, nextMonth) %>" aria-label="Next month">Next ›</a>
        <% if (month !== today.slice(0, 7)) { %><a class="sm-link-btn" href="<%= url(pageId, today.slice(0, 7)) %>">This month</a><% } %>
      </div>
    </div>
    <div class="sm-scroll sm-sheet-scroll"><table class="sm-table sm-sheet min-1100" aria-label="<%= pageName %> content sheet">
      <thead><tr><% cols.forEach(function (c) { %><th><%= c %></th><% }) %><% if (can) { %><th></th><% } %></tr></thead>
      <tbody>
        <% days.forEach(function (day) {
             var list = day.rows.length ? day.rows.concat(drafts['d' + day.date] ? [null] : []) : [null];
             list.forEach(function (r) {
               var k = r ? 'r' + r.id : 'd' + day.date;
               var draft = drafts[k];
               var v = draft ? Object.assign({}, r, draft) : r; // v = what the cells show, r = what is saved
               var cls = (day.date === today ? 'sm-today ' : '') + (r ? '' : 'sm-sheet-blank ') + (rowErrors[k] ? 'sm-sheet-err' : ''); %>
          <tr <% if (r) { %>id="row-<%= r.id %>"<% } %> class="<%= cls %>" <%= draft ? 'data-draft' : '' %>>
            <% if (can) { %>
              <td class="sm-c"><% if (r) { %><input class="sm-cell" type="date" name="<%= k %>.publishDate" form="sheet-save" value="<%= v.publishDate %>" aria-label="Publish date"><% } else { %><span class="nowrap"><%= fmt(day.date) %></span><% } %><%- by(r, 'publishDate') %></td>
              <td class="sm-c"><input class="sm-cell" name="<%= k %>.name" form="sheet-save" value="<%= v ? v.name : '' %>" maxlength="150" aria-label="Name"><%- by(r, 'name') %></td>
              <td class="sm-c"><input class="sm-cell" type="date" name="<%= k %>.shootDate" form="sheet-save" value="<%= v && v.shootDate || '' %>" aria-label="Shoot date"><%- by(r, 'shootDate') %></td>
              <% ['materialReady', 'shootStatus', 'editingStatus'].forEach(function (c) { %><td class="sm-c"><%- select(k, c, v ? v[c] : '') %><%- by(r, c) %></td><% }) %>
              <% if (r && r.lockedAt) { %>
                <td class="sm-c"><%- V.badge(r.publishStatus, tone[r.publishStatus] || 'slate') %><%- by(r, 'publishStatus') %></td>
                <td class="sm-c nowrap"><%- postLink(r) %><%- by(r, 'link') %></td>
              <% } else { %>
                <td class="sm-c"><%- select(k, 'publishStatus', v ? v.publishStatus : '') %><%- by(r, 'publishStatus') %></td>
                <td class="sm-c"><input class="sm-cell sm-link-cell" type="url" name="<%= k %>.link" form="sheet-save" value="<%= v && v.link || '' %>" maxlength="500" placeholder="https://instagram.com/…" aria-label="Post link"><%- by(r, 'link') %></td>
              <% } %>
              <td class="sm-c"><input class="sm-cell" name="<%= k %>.note" form="sheet-save" value="<%= v ? v.note : '' %>" maxlength="1000" aria-label="Note"><%- by(r, 'note') %></td>
              <td class="nowrap">
                <% if (r && sheet.admin) { %><form method="POST" action="/content-sheet/<%= r.id %>" style="display:inline" data-confirm="Delete this row?"><input type="hidden" name="_csrf" value="<%= sheet.csrf %>"><input type="hidden" name="remove" value="1"><button class="btn small ghost" type="submit" aria-label="Delete row">×</button></form><% } %>
              </td>
            <% } else { %>
              <td class="sm-c nowrap"><%= fmt(day.date) %><%- by(r, 'publishDate') %></td>
              <td class="sm-c"><b><%= r ? r.name : '' %></b><%- by(r, 'name') %></td>
              <td class="sm-c nowrap"><%= r ? fmt(r.shootDate) : '' %><%- by(r, 'shootDate') %></td>
              <% ['materialReady', 'shootStatus', 'editingStatus', 'publishStatus'].forEach(function (k) { %><td class="sm-c"><%- r && r[k] ? V.badge(r[k], tone[r[k]] || 'slate') : '' %><%- by(r, k) %></td><% }) %>
              <td class="sm-c nowrap"><%- r ? postLink(r) : '' %><%- by(r, 'link') %></td>
              <td class="sm-c"><%= r ? r.note : '' %><%- by(r, 'note') %></td>
            <% } %>
          </tr>
        <% }); }); %>
        <% if (can) { %>
          <tr class="sm-sheet-new">
            <td><input class="sm-cell" type="date" name="addDate" form="sheet-save" min="<%= month %>-01" max="<%= days[days.length - 1].date %>" aria-label="Extra row publish date"></td>
            <td colspan="8" class="sm-muted">Second post on the same day? Pick the date and click + Add row; a new line appears on that day, and anything you typed above is saved too.</td>
            <td><button class="btn small" type="submit" form="sheet-save" name="addRow" value="1">+ Add row</button></td>
          </tr>
        <% } %>
      </tbody>
    </table></div>
  </div>

  <% if (sheet.admin) { %>
    <details class="list-card sm-section" style="padding:16px 20px" id="share" <%= viewers.length ? '' : 'open' %>>
      <summary><b>Who can see this sheet</b> · <%= viewers.length %> shared</summary>
      <p class="sm-muted">Ticked people get a Content Sheet link in their menu and can add rows and edit them (PMS viewers can only view). Only admins can delete rows or change this list. This does not give them Social Media Studio access.</p>
      <form method="POST" action="/content-sheet/access">
        <input type="hidden" name="_csrf" value="<%= sheet.csrf %>">
        <div class="sm-share-list">
          <% shareable.forEach(function (u) { %>
            <label><input type="checkbox" name="viewers" value="<%= u.id %>" <%= viewers.includes(u.id) ? 'checked' : '' %>> <%= u.name %> <span class="sm-muted">(<%= u.role === 'viewer' ? 'Viewer' : 'Team member' %>)</span></label>
          <% }) %>
          <% if (!shareable.length) { %><p class="sm-muted">No other active PMS users yet.</p><% } %>
        </div>
        <button class="btn small" type="submit">Save sharing</button>
      </form>
    </details>
  <% } %>
</div>
<script src="/studio.js" defer></script>
<%- include('../partials/footer') %>
