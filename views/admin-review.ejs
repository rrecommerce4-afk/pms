<%- include('partials/header') %>
<div class="container container-wide">
  <div class="page-head">
    <div>
      <div class="eyebrow-date">ADMIN OVERVIEW</div>
      <h1><%= heading %></h1>
      <p>Submitted kaam jo aapke approval ka wait kar raha hai.</p>
    </div>
  </div>

  <div class="list-card">
    <div class="list-card-head section-card-head">
      <h2>Pending Review <span class="tag-count"><%= filtered.length %></span></h2>
    </div>
    <%- include('partials/task-table', { tasks: filtered, showAssignee: true, assigneeColLabel: 'Submitted By', showDelete: false, pageUrl: pageUrl, emptyTitle: 'Abhi koi task review ke liye pending nahi hai.' }) %>
  </div>
</div>
<%- include('partials/task-detail') %>
<%- include('partials/task-modal') %>
<%- include('partials/footer') %>
