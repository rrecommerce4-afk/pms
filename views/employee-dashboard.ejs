<%- include('partials/header') %>
<%
  var dueSoon = summary.total - summary.completed;
  var pageDesc = dueSoon
    ? ('Aapke paas ' + dueSoon + ' active task' + (dueSoon === 1 ? '' : 's') + ' hai' + (dueSoon === 1 ? '' : 'n') + ', ' + summary.changes + ' par changes maange gaye hain.')
    : 'Abhi koi active task nahi hai — nice and clear!';
%>
<div class="container container-wide">
  <div class="page-head">
    <div>
      <div class="eyebrow-date">MY WORK</div>
      <h1><%= heading %></h1>
      <p><%= pageDesc %></p>
    </div>
  </div>

  <div class="summary-row">
    <a class="sum-card" href="/employee/tasks">
      <div class="sum-card-top"><span class="sum-label">My Tasks</span><div class="sum-icon" style="background:var(--info-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--info)" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></div></div>
      <div class="sum-value"><%= summary.total %></div><div class="sum-sub">Assigned to me</div>
    </a>
    <a class="sum-card" href="/employee/tasks">
      <div class="sum-card-top"><span class="sum-label">In Progress</span><div class="sum-icon" style="background:var(--info-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--info)" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div></div>
      <div class="sum-value"><%= summary.inProgress %></div><div class="sum-sub">Currently working</div>
    </a>
    <a class="sum-card" href="/employee/tasks">
      <div class="sum-card-top"><span class="sum-label">Changes Requested</span><div class="sum-icon" style="background:var(--warning-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></div></div>
      <div class="sum-value"><%= summary.changes %></div><div class="sum-sub">Needs rework</div>
    </a>
    <a class="sum-card<%= summary.overdue ? ' warn' : '' %>" href="/employee/tasks">
      <div class="sum-card-top"><span class="sum-label">Overdue</span><div class="sum-icon" style="background:<%= summary.overdue ? 'var(--danger-soft)' : 'var(--success-soft)' %>;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="<%= summary.overdue ? 'var(--danger)' : 'var(--success)' %>" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></div></div>
      <div class="sum-value"><%= summary.overdue %></div><div class="sum-sub"><%= summary.overdue ? 'Needs attention' : "You're on track" %></div>
    </a>
    <a class="sum-card" href="/employee/completed">
      <div class="sum-card-top"><span class="sum-label">Completed</span><div class="sum-icon" style="background:var(--success-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></div></div>
      <div class="sum-value"><%= summary.completed %></div><div class="sum-sub">All time</div>
    </a>
  </div>

  <div class="list-card">
    <div class="list-card-head section-card-head"><h2>Today's Focus</h2></div>
    <div style="padding:16px 18px;">
      <% if (focus.length) { %>
        <div class="focus-grid">
          <% focus.forEach(function (t) { %>
            <div class="focus-card<%= t.status === 'changes' ? ' changes' : '' %>">
              <div class="fc-top"><div class="fc-title"><%= t.title %></div><span class="badge p-<%= t.priority %>"><%= t.priorityText %></span></div>
              <div class="fc-meta">Due <%= t.dueLabel %> &middot; <%= t.statusLabel %></div>
              <div class="fc-actions"><a class="btn" href="<%= taskUrl(pageUrl, t.id) %>"><%= t.status === 'changes' ? 'View Feedback' : (t.status === 'todo' ? 'Start Task' : 'Open') %></a></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="empty-state-title">Aaj koi urgent task nahi hai</div>
        </div>
      <% } %>
    </div>
  </div>

  <div class="list-card">
    <div class="list-card-head section-card-head">
      <h2>My Task List</h2>
      <%- include('partials/view-toggle', { basePath: '/employee/dashboard' }) %>
    </div>
    <% if (filters.view === 'kanban') { %>
      <%- include('partials/kanban', { tasks: taskListTasks, showAssignee: false, pageUrl: pageUrl }) %>
    <% } else { %>
      <%- include('partials/task-groups', { groups: groups, pageUrl: pageUrl }) %>
    <% } %>
  </div>

  <div class="split-row">
    <div class="section-card col-main" style="padding:0;">
      <div class="list-card-head section-card-head"><h2>Review Updates</h2></div>
      <% if (reviewUpdates.length) { %>
        <% reviewUpdates.forEach(function (t) { %>
          <% var lastComment = t.comments.length ? t.comments[t.comments.length - 1] : null; %>
          <a class="attn-row" href="<%= taskUrl(pageUrl, t.id) %>">
            <div class="attn-flag <%= t.status === 'changes' ? 'amber' : 'blue' %>"></div>
            <div class="attn-body"><div class="attn-title"><%= t.title %></div><div class="attn-meta"><%= t.status === 'changes' ? (lastComment ? 'Admin: "' + lastComment.text + '"' : 'Changes requested') : 'Approved · Marked Completed' %></div></div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><div class="empty-state-title">Koi review update nahi hai</div></div>
      <% } %>
    </div>
    <div class="section-card col-side" style="padding:0;">
      <div class="list-card-head section-card-head"><h2>Upcoming Tasks</h2></div>
      <% if (upcoming.length) { %>
        <% upcoming.forEach(function (t) { %>
          <a class="attn-row" href="<%= taskUrl(pageUrl, t.id) %>">
            <div class="attn-flag blue"></div>
            <div class="attn-body"><div class="attn-title"><%= t.title %></div><div class="attn-meta">Due <%= t.dueLabel %> &middot; <%= t.priorityText %> priority</div></div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><div class="empty-state-title">Koi upcoming task nahi hai</div></div>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/task-detail') %>
<%- include('partials/footer') %>
