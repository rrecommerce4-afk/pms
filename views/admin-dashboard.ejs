<%- include('partials/header') %>
<div class="container container-wide">
  <div class="page-head">
    <div>
      <div class="eyebrow-date">ADMIN OVERVIEW</div>
      <h1><%= heading %></h1>
      <p><%= chipDate %> &middot; <%= employeeCount %> member<%= employeeCount === 1 ? '' : 's' %> &middot; <%= totalDailyTasks %> task<%= totalDailyTasks === 1 ? '' : 's' %> &middot; <%= completed %>/<%= total %> done today</p>
    </div>
  </div>

  <div class="dash-layout">
    <div class="section-card attn-card">
      <div class="attn-card-head">
        <div>
          <h2>Needs attention</h2>
          <p>Employees with pending tasks today, most behind first.</p>
        </div>
        <span class="pill-stat warning"><%= pending %> pending</span>
      </div>
      <div class="attn-list">
        <% needsAttention.forEach(function(e) { %>
          <div class="attn-row">
            <div class="attn-who">
              <div class="avatar-wrap">
                <div class="avatar"><%= e.name.trim().charAt(0).toUpperCase() %></div>
                <% if (e.missed > 0) { %><a class="missed-badge" href="/admin/missed?employee=<%= e.id %>" title="<%= e.missed %> missed task(s) &mdash; click to view"><%= e.missed %></a><% } %>
              </div>
              <div>
                <div class="attn-name"><%= e.name %></div>
                <div class="attn-dept"><%= e.department %></div>
              </div>
            </div>
            <div class="attn-progress">
              <span class="attn-track"><span class="attn-fill" style="width:<%= e.pct %>%"></span></span>
              <span class="attn-count"><b><%= e.completed %></b>/<%= e.total %> done</span>
            </div>
          </div>
        <% }) %>
        <% if (needsAttention.length === 0) { %>
          <div class="attn-row" style="color:var(--text-faint);">No employees yet. Add one from the Employees page.</div>
        <% } %>
      </div>
    </div>

    <div class="dash-side">
      <div class="section-card tc-card">
        <h2>Today's completion</h2>
        <div class="tc-percent-row">
          <span class="tc-percent"><%= donutPct %>%</span>
          <span class="tc-caption">of today's tasks marked done</span>
        </div>
        <span class="tc-track"><span class="tc-fill" style="width:<%= donutPct %>%"></span></span>
        <div class="tc-legend">
          <span class="legend-item"><span class="legend-dot completed"></span> <%= completed %> completed</span>
          <span class="legend-item"><span class="legend-dot pending"></span> <%= pending %> pending</span>
        </div>
      </div>

      <div class="section-card snapshot-card">
        <h2>Team snapshot</h2>
        <div class="snapshot-list">
          <div class="snapshot-row"><span class="snapshot-label">Team members</span><span class="snapshot-value"><%= employeeCount %></span></div>
          <div class="snapshot-row"><span class="snapshot-label">Admins</span><span class="snapshot-value"><%= adminCount %></span></div>
          <div class="snapshot-row"><span class="snapshot-label">Total daily tasks</span><span class="snapshot-value"><%= totalDailyTasks %></span></div>
          <div class="snapshot-row"><span class="snapshot-label">Missed yesterday</span><span class="snapshot-value danger"><%= missedYesterday %></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="section-card">
    <div class="section-card-head">
      <div>
        <div class="eyebrow">RECENT TASKS</div>
        <h2>Today's Team Tasks</h2>
      </div>
      <a class="view-all" href="/admin/tasks">View all tasks &rsaquo;</a>
    </div>
    <div class="table-card" style="box-shadow:none; border:1px solid var(--border);">
      <div class="table-scroll">
      <table>
        <thead>
          <tr><th>Task Name</th><th>Assigned To</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% recentTasks.forEach(function(r) { %>
            <% const done = r.log.status === 'completed'; %>
            <tr>
              <td>
                <div class="name-cell">
                  <span class="status-dot <%= done ? 'completed' : 'pending' %>">
                    <% if (done) { %><svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><% } %>
                  </span>
                  <span style="<%= done ? 'color:var(--text-faint); text-decoration:line-through;' : '' %>"><%= r.task.title %></span>
                </div>
              </td>
              <td>
                <div class="name-cell">
                  <div class="avatar" style="width:26px;height:26px;font-size:11px;"><%= r.employeeName.trim().charAt(0).toUpperCase() %></div>
                  <%= r.employeeName %>
                </div>
              </td>
              <td>
                <span class="badge icon-pill <%= done ? 'completed' : 'pending' %>">
                  <% if (done) { %>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg> Complete
                  <% } else { %>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.4"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg> Pending
                  <% } %>
                </span>
              </td>
            </tr>
          <% }) %>
          <% if (recentTasks.length === 0) { %>
            <tr class="empty-row"><td colspan="3">No tasks yet today.</td></tr>
          <% } %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
