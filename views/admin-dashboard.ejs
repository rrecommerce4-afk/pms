<%- include('partials/header') %>
<div class="container container-wide">
  <div class="page-head">
    <div>
      <div class="eyebrow-date">ADMIN OVERVIEW</div>
      <h1><%= heading %></h1>
      <p>Team ka overview &mdash; kaam kaha atka hai aur kya review ke liye ready hai.</p>
    </div>
  </div>

  <div class="summary-row">
    <a class="sum-card" href="/admin/tasks">
      <div class="sum-card-top"><span class="sum-label">Total Tasks</span><div class="sum-icon" style="background:var(--info-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--info)" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></div></div>
      <div class="sum-value"><%= summary.total %></div><div class="sum-sub"><%= summary.employeeCount %> employees</div>
    </a>
    <a class="sum-card" href="/admin/tasks?due=all">
      <div class="sum-card-top"><span class="sum-label">In Progress</span><div class="sum-icon" style="background:var(--info-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--info)" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div></div>
      <div class="sum-value"><%= summary.inProgress %></div><div class="sum-sub">Active right now</div>
    </a>
    <a class="sum-card" href="/admin/review">
      <div class="sum-card-top"><span class="sum-label">Pending Review</span><div class="sum-icon" style="background:var(--purple-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--purple)" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg></div></div>
      <div class="sum-value"><%= summary.pendingReview %></div><div class="sum-sub">Waiting on you</div>
    </a>
    <a class="sum-card<%= summary.overdue ? ' warn' : '' %>" href="/admin/tasks?due=overdue">
      <div class="sum-card-top"><span class="sum-label">Overdue</span><div class="sum-icon" style="background:var(--danger-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></div></div>
      <div class="sum-value"><%= summary.overdue %></div><div class="sum-sub">Past due date</div>
    </a>
    <a class="sum-card" href="/admin/tasks">
      <div class="sum-card-top"><span class="sum-label">Completed</span><div class="sum-icon" style="background:var(--success-soft);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg></div></div>
      <div class="sum-value"><%= summary.completed %></div><div class="sum-sub">All time</div>
    </a>
  </div>

  <div class="list-card">
    <div class="list-card-head section-card-head">
      <h2>Needs Attention</h2>
      <span class="tag-count"><%= attention.length %></span>
    </div>
    <% if (attention.length) { %>
      <% attention.forEach(function (t) { %>
        <%
          var flag = 'blue', meta = '';
          if (t.overdue) { flag = 'red'; meta = 'Assigned to ' + t.assigneeName + ' · Due ' + t.dueLabel + ' · ' + t.overdueDaysCount + ' day' + (t.overdueDaysCount > 1 ? 's' : '') + ' overdue'; }
          else if (t.status === 'blocked') { flag = 'amber'; meta = 'Assigned to ' + t.assigneeName + ' · Blocked: ' + (t.blockedReason || ''); }
          else if (t.status === 'review') { meta = 'Submitted by ' + t.assigneeName + ' · Waiting for your review'; }
        %>
        <a class="attn-row" href="<%= taskUrl(pageUrl, t.id) %>">
          <div class="attn-flag <%= flag %>"></div>
          <div class="attn-body"><div class="attn-title"><%= t.title %></div><div class="attn-meta"><%= meta %></div></div>
          <% if (t.overdue) { %><span class="attn-badge overdue">Overdue</span>
          <% } else if (t.status === 'blocked') { %><span class="attn-badge blocked">Blocked</span>
          <% } else if (t.status === 'review') { %><span class="attn-badge review">In Review</span><% } %>
        </a>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div class="empty-state-title">Sab kuchh on track hai!</div>
        <div class="empty-state-sub">Koi overdue, blocked ya pending review task nahi hai.</div>
      </div>
    <% } %>
  </div>

  <div class="list-card">
    <div class="list-card-head section-card-head">
      <h2>Task Overview</h2>
      <%- include('partials/view-toggle', { basePath: '/admin/dashboard' }) %>
    </div>
    <% if (filters.view === 'kanban') { %>
      <%- include('partials/kanban', { tasks: filtered, showAssignee: true, pageUrl: pageUrl }) %>
    <% } else { %>
      <%- include('partials/task-table', { tasks: filtered, showAssignee: true, showDelete: false, pageUrl: pageUrl, emptyTitle: 'Koi task nahi mila' }) %>
    <% } %>
  </div>

  <div class="split-row">
    <div class="section-card col-main" style="padding:0;">
      <div class="list-card-head section-card-head">
        <h2>Team Workload</h2>
        <a class="link-more" href="/admin/workload">Full report &rarr;</a>
      </div>
      <div class="workload-list">
        <% if (workload.length) { %>
          <% workload.forEach(function (r) { %>
            <a class="wl-row" href="/admin/tasks?employee=<%= r.employee.id %>">
              <div class="wl-avatar"><%= r.employee.name.trim().split(/\s+/).map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() %></div>
              <div><div class="wl-name"><%= r.employee.name %></div><div class="wl-role"><%= r.employee.department || 'Team Member' %></div></div>
              <div class="wl-bar-wrap"><div class="wl-bar-track"><div class="wl-bar-fill" style="width:<%= r.pct %>%;"></div></div><div class="wl-bar-label"><%= r.active %> active</div></div>
              <div class="wl-stats"><div class="wl-stat"><div class="wl-stat-val<%= r.overdue ? ' red-txt' : '' %>"><%= r.overdue %></div><div class="wl-stat-label">OVERDUE</div></div></div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="empty-state"><div class="empty-state-title">No employees yet.</div></div>
        <% } %>
      </div>
    </div>
    <div class="section-card col-side" style="padding:0;">
      <div class="list-card-head section-card-head"><h2>Recent Activity</h2></div>
      <% if (activity.length) { %>
        <% activity.forEach(function (a) { %>
          <div class="activity-row"><div class="act-dot"></div><div><div class="act-text"><%- a.text %></div><div class="act-time"><%= a.time %></div></div></div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><div class="empty-state-title">No recent activity yet.</div></div>
      <% } %>
    </div>
  </div>
</div>
<%- include('partials/task-detail') %>
<%- include('partials/task-modal') %>
<%- include('partials/footer') %>
