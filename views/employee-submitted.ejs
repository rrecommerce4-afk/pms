      <div class="eyebrow-date">MY WORK</div>
      <h1><%= heading %></h1>
      <p>Aapke submit kiye hue kaam ka status.</p>
    </div>
  </div>

  <div class="list-card">
    <div class="list-card-head section-card-head"><h2>In Review <span class="tag-count"><%= filtered.length %></span></h2></div>
